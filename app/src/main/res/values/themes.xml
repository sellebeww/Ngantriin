<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
         Dipakai saat proses mulai. installSplashScreen() menukar ke
         postSplashScreenTheme begitu frame pertama siap, lalu
         SplashScreen Compose menutupi pemulihan sesi.
    -->
    <style name="Theme.Ngantriin.Starting" parent="Theme.SplashScreen">
        <!--
             Krem, sama persis dengan latar SplashScreen Compose supaya
             tidak ada kilatan warna saat postSplashScreenTheme mengambil alih.
        -->
        <item name="windowSplashScreenBackground">@color/cloud</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Ngantriin</item>
    </style>

    <style name="Theme.Ngantriin" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Sama dengan latar Compose supaya tidak berkedip saat rotasi. -->
        <item name="android:windowBackground">@color/cloud</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
   Nothing on the device is worth restoring onto another one: the Room cache is
   rebuilt from Supabase, the sign-in session lives in shared preferences (a
   restored token would hand one phone's session to another), and unsent
   offline actions refer to tickets that may no longer be valid. So every
   domain is excluded from both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>

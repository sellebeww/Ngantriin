<?xml version="1.0" encoding="utf-8"?>
<!--
     Tidak ada yang di perangkat layak dipulihkan ke perangkat lain: cache Room
     dibangun ulang dari Supabase, sesi login ada di shared preferences (token
     yang dipulihkan akan memberi sesi satu HP ke HP lain), dan aksi offline yang
     belum terkirim merujuk tiket yang mungkin sudah tidak valid. Jadi semua
     domain dikecualikan dari backup cloud maupun transfer antar perangkat.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
